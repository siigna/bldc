build
tools
downloads
package/

.dep
.project
.cproject
.settings/language.settings.xml
.DS_Store
workspace.code-workspace

# Qt project settings
*.pro.user
*.pro.shared

.vscode

.cache
compile_commands.json

/result

# Vim swap files. A stray one has been committed here before: it is 12 KB of
# binary that git add -A picks up silently.
*.swp
.*.swp

# Host test and analysis output. The binaries, the gcov annotations and the
# fuzzer's corpus are all regenerated by tests/check.sh; committing them once
# cost a filter-branch already.
tests/*/*.o
tests/*/test
tests/*/test-[a-z]*
tests/*/fuzz
tests/*/corpus/
tests/*/crash-*
tests/*/leak-*
tests/*/timeout-*
*.gcov
*.gcda
*.gcno
